{
  "manifest_version": 3,
  "name": "YouTube 자막 변환기",
  "version": "1.1.0",
  "description": "시스템 언어에 맞춰 YouTube 자막을 자동으로 타겟 언어로 번역합니다",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}